{
  "name": "kikoeru-next",
  "version": "1.0.3",
  "private": true,
  "description": "Local-first ASMR library and player with ASMR.one online mode",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "probe": "npm run probe --workspace @kikoeru-next/probe --",
    "probe:test": "npm run test --workspace @kikoeru-next/probe",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev --workspace @kikoeru-next/server",
    "start:server": "npm run start --workspace @kikoeru-next/server",
    "dev:web": "npm run dev --workspace @kikoeru-next/web",
    "build:web": "npm run build --workspace @kikoeru-next/web",
    "dev:desktop": "npm run dev --workspace @kikoeru-next/desktop",
    "pack:desktop": "npm run pack --workspace @kikoeru-next/desktop"
  },
  "engines": {
    "node": ">=22"
  }
}
